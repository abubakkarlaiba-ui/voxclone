# VoxClone Environment Variables Template
# Copy this file to .env.local and fill in the values

# ─── Voice Provider ───────────────────────────────────────────────
# Choose a provider: "elevenlabs" | "mock"
# If no API key is set, the app falls back to "mock" automatically.
VOICE_PROVIDER=

# ElevenLabs API key (required when VOICE_PROVIDER=elevenlabs)
# Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: Override the default ElevenLabs API base URL
# ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# ─── Authentication ───────────────────────────────────────────────
# REQUIRED for production: Secret key for JWT signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In development, a default is used if not set.
SESSION_SECRET=
